#!/bin/bash
#PBS -N mf_score
#PBS -q v1_medium24
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=08:00:00
#PBS -o logs/minifold_score.out
#PBS -e logs/minifold_score.err

cd "$PBS_O_WORKDIR"
mkdir -p logs

PY=/rds/general/user/ha1822/home/code/nanolab/mentos/.venv/bin/python
NAT=/rds/general/user/ha1822/home/MENTOS/LOGS/dockq_stage3_cap50_full
OUT=/rds/general/user/ha1822/home/MENTOS/LOGS/minifold_eval

echo "host=$(hostname) date=$(date)"
echo "predictions: $(ls "$OUT"/*_pred.pdb 2>/dev/null | wc -l)"

echo "=== DockQ ==="
$PY score_dockq_dir.py "$OUT" "$OUT/dockq_results.json" minifold_48L 2>&1 | tail -20

echo "=== monomer metrics ==="
$PY monomer_metrics.py "$OUT" "$OUT/monomer_metrics.csv" 2>&1 | tail -20

echo "=== random-placement null (10 draws/target) ==="
$PY minifold_null_control.py "$OUT" "$NAT" "$TMPDIR/null" "$OUT/null_control.json" 2>&1 | tail -15

echo "=== random-placement null on MENTOS step-50000 (same test, reference) ==="
$PY minifold_null_control.py "$NAT" "$NAT" "$TMPDIR/null_mentos" \
    /rds/general/user/ha1822/home/MENTOS/LOGS/minifold_eval/null_control_mentos50000.json 2>&1 | tail -15

echo "=== random-placement null on MENTOS step-14000 (best interface geometry) ==="
M14=/rds/general/user/ha1822/home/MENTOS/LOGS/dockq_stage3_cap50_step14000
if [ -d "$M14" ]; then
  $PY minifold_null_control.py "$M14" "$M14" "$TMPDIR/null_m14" \
      /rds/general/user/ha1822/home/MENTOS/LOGS/minifold_eval/null_control_mentos14000.json 2>&1 | tail -15
else
  echo "SKIP: $M14 not present"
fi

echo "exit=$? date=$(date)"
