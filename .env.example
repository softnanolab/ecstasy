# Copy to .env (gitignored) and set the absolute paths for your machine.
# These are filesystem roots; ecstasy.config reads them (env > .env > error-if-empty).

DATA_ROOT=/path/to/ecstasy_data          # all run outputs: $DATA_ROOT/{runs,msa_store}
MENTOS_ROOT=/path/to/MENTOS/DATA         # MENTOS splits + ground truth
ECSTASY_ROOT=/path/to/ecstasy            # model weights (e.g. msa_pairformer)
ENVS_ROOT=/path/to/ecstasy/envs          # per-model venvs (.venv-boltz, .venv-colabfold, ...)
TOOLS_ROOT=/path/to/ecstasy/tools        # vendored binaries (mmseqs, mmseqs-gpu, hhsuite)

# Optional integrations
# NOTION_API_TOKEN=                        # required to read/write the Notion registry below
# COLABFOLD_DBS=/path/to/colabfold_dbs   # uniref30 + colabfold_envdb (server-identical)

# Notion benchmarking registry — the SOURCE OF TRUTH for everything concrete. The repo commits
# NO paths; benchmark scripts take checkpoint/dataset *names* and resolve them against the
# Registry tables (Checkpoints / Datasets) on this page. The page also holds a Benchmarking Log
# (dated narrative campaign entries: goal → results-with-figures → decision → artifacts) — that's
# where raw results and charts live, in context. New agents/contributors: use this page.
ECSTASY_NOTION_PAGE=https://www.notion.so/agrawalh/Ecstasy-374702c0f740804d946ff830fd35da13
